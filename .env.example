ANTHROPIC_API_KEY=your_api_key_here
PORT=3001

# Clerk (same application as the other Kato.8 tools)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...        # enables role checks on the API

# Supabase storage for actions, signing, onboarding (run supabase/hr_records.sql once).
# Leave unset locally to use JSON files next to server.js.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Google Drive (optional). Authorized redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://hr.kato8studiosapp.xyz
